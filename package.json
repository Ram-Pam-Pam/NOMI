{
  "name": "nomi-krakow",
  "version": "1.0.0",
  "private": true,
  "description": "NOMI – przewodnik AI po Krakowie: agent tekstowy i głosowy, nawigacja piesza i komunikacją miejską, planer zwiedzania.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
