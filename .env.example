# Skopiuj do .env i uzupełnij.

# ---------------------------------------------------------------- AI: Sherlock (CloudFerro) – zalecane
# Klucz z panelu https://sherlock.cloudferro.com (API keys). Sprawdzenie: npm run check:llm
LLM_PROVIDER=sherlock
LLM_API_KEY=
# LLM_BASE_URL=https://api-sherlock.cloudferro.com/openai/v1

# Modele: rozmowa z narzędziami / opowieści o atrakcjach / planer dnia
NOMI_CHAT_MODEL=openai/gpt-oss-120b
NOMI_NARRATE_MODEL=speakleash/Bielik-11B-v3.0-Instruct
NOMI_PLAN_MODEL=openai/gpt-oss-120b
# Poziom rozumowania gpt-oss (low | medium | high) – niższy = szybsze odpowiedzi głosowe
NOMI_REASONING_EFFORT=low
NOMI_PLAN_REASONING_EFFORT=medium

# ---------------------------------------------------------------- AI: Claude (alternatywa)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NOMI_MODEL=claude-opus-5-5
# NOMI_EFFORT=low
# NOMI_PLAN_EFFORT=medium
# NOMI_FALLBACKS=off

PORT=3000

# Oficjalne dane atrakcji (godziny, ceny, fakty) – co ile godzin odświeżać ze stron instytucji i krakow.travel.
# OFFICIAL_TTL_HOURS=72
# Baza wiedzy z oficjalnych stron (npm run rag:build): model embeddingów na Sherlocku (off = tylko słowa kluczowe)
# i co ile dni przebudowywać ją w tle.
# RAG_EMBED_MODEL=BAAI/bge-multilingual-gemma2
# RAG_TTL_DAYS=7
# Katalog na rozkłady GTFS i dane oficjalne (domyślnie ./data).
# NOMI_DATA_DIR=data

# HTTPS (wymagany przez GPS i kompas na telefonie, poza localhost):
# HTTPS_KEY=certs/key.pem
# HTTPS_CERT=certs/cert.pem

# Zewnętrzne usługi (domyślnie publiczne instancje – do produkcji użyj własnych):
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# NOMI_USER_AGENT=NOMI-Krakow-Guide/1.0 (kontakt@twojadomena.pl)
